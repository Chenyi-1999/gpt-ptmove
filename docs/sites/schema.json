{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "announce_hosts": {
      "items": {
        "maxLength": 253,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "base_url": {
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://",
      "type": "string"
    },
    "engine": {
      "const": "nexusphp",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "official_groups": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "paths": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "download": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "listing": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "search": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "ptnexus_site": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": [
        "string",
        "null"
      ]
    },
    "roles": {
      "items": {
        "enum": [
          "source",
          "target"
        ]
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "selectors": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "detail_link": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "download_link": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "leechers": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "official": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "peers": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "restriction_allowed": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "restriction_denied": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "search_empty": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "search_results": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "seeders": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "table": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "tags": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "base_url",
    "roles"
  ],
  "title": "STARPT declarative site profile",
  "type": "object"
}
