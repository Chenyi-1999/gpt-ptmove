{
  "$defs": {
    "ProfilePaths": {
      "additionalProperties": false,
      "properties": {
        "listing": {
          "default": "/torrents.php",
          "title": "Listing",
          "type": "string"
        },
        "detail": {
          "default": "/details.php?id={id}",
          "title": "Detail",
          "type": "string"
        },
        "download": {
          "default": "/download.php?id={id}",
          "title": "Download",
          "type": "string"
        },
        "search": {
          "default": "/torrents.php?search={query}",
          "title": "Search",
          "type": "string"
        }
      },
      "title": "ProfilePaths",
      "type": "object"
    },
    "ProfileSelectors": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "default": "table.torrents, table#torrenttable",
          "title": "Table",
          "type": "string"
        },
        "detail_link": {
          "default": "a[href*=\"details.php?id=\"]",
          "title": "Detail Link",
          "type": "string"
        },
        "title": {
          "default": "h1, #top, .torrent-title",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "#kdescr, #description, .description",
          "title": "Description",
          "type": "string"
        },
        "download_link": {
          "default": "a[href*=\"download.php\"]",
          "title": "Download Link",
          "type": "string"
        },
        "tags": {
          "default": ".tag, .tags, .torrent-tag, .label",
          "title": "Tags",
          "type": "string"
        },
        "peers": {
          "default": "#peercount, #peers, .peers",
          "title": "Peers",
          "type": "string"
        }
      },
      "title": "ProfileSelectors",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "base_url": {
      "maxLength": 512,
      "title": "Base Url",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "source",
          "target"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "engine": {
      "const": "nexusphp",
      "default": "nexusphp",
      "title": "Engine",
      "type": "string"
    },
    "ptnexus_site": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Site mapping code"
    },
    "official_groups": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Official Groups",
      "type": "array"
    },
    "announce_hosts": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Announce Hosts",
      "type": "array"
    },
    "paths": {
      "$ref": "#/$defs/ProfilePaths"
    },
    "selectors": {
      "$ref": "#/$defs/ProfileSelectors"
    }
  },
  "required": [
    "id",
    "name",
    "base_url",
    "roles"
  ],
  "title": "SiteProfile",
  "type": "object"
}
