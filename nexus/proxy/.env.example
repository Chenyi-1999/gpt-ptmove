# Generate a random token; this file intentionally contains no usable credential.
PTMOVE_PROXY_TOKEN=
# Keep this absolute path identical to qB's save_path (or its enclosing media root).
PTMOVE_MEDIA_SOURCE=/volume1/downloads
PTMOVE_MEDIA_ROOTS='["/volume1/downloads"]'
PTMOVE_BIND_IP=127.0.0.1
PTMOVE_PROXY_PORT=19090
