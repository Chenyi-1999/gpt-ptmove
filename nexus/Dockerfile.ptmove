# PTMOVE fork of PTNexus, upstream 53eee1fed09121867f956c798c158c13a475d51f.
FROM node:20-alpine AS webui-builder
WORKDIR /src/webui
ENV NODE_OPTIONS=--max-old-space-size=1024
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm install -g pnpm@10.0.0 --registry=${NPM_REGISTRY}
COPY webui/package.json webui/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --registry=${NPM_REGISTRY}
COPY webui/ ./
RUN pnpm run type-check && pnpm run build

FROM golang:1.23-alpine AS server-builder
WORKDIR /src/server
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=512MiB
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN go test -trimpath ./... && go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

FROM python:3.12-slim-bookworm AS bdinfo-builder
WORKDIR /build
COPY scripts/fetch_native_assets.py ./
COPY builddeps/bdinfo/ /out/bdinfo/
RUN python fetch_native_assets.py /out/bdinfo

FROM debian:bookworm-slim
ARG APT_MIRROR=http://deb.debian.org
LABEL org.opencontainers.image.title="PTMOVE Nexus" \
      org.opencontainers.image.version="0.3.0" \
      org.opencontainers.image.source="https://gitee.com/star1999/gpt-ptmove" \
      org.opencontainers.image.base.name="sqing33/PTNexus@53eee1fed09121867f956c798c158c13a475d51f"
RUN sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg mediainfo mpv fonts-noto-cjk libicu72 util-linux \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/server
ENV SERVER_HOST=0.0.0.0 SERVER_PORT=5275 GIN_MODE=release TZ=Asia/Shanghai \
    PTNEXUS_BASE_DIR=/app/server PTNEXUS_DATA_DIR=/app/data \
    PTNEXUS_LOG_DIR=/app/data/logs PTNEXUS_BDINFO_DIR=/app/bdinfo/linux \
    NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1
COPY --from=server-builder /out/server ./server
COPY server/configs ./configs
COPY server/sites_data.json ./sites_data.json
COPY --from=webui-builder /src/webui/dist ./dist
COPY --from=bdinfo-builder /out/bdinfo /app/bdinfo/linux
RUN mkdir -p /app/data/tmp /app/data/logs && chmod 700 /app/data
VOLUME ["/app/data"]
EXPOSE 5275
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD ["/app/server/server", "--healthcheck"]
ENTRYPOINT ["/app/server/server"]
